generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Categoria {
  id                 Int        @id(map: "PK__Categori__3213E83F70DA985B") @default(autoincrement())
  nombre             String     @db.NVarChar(100)
  descripcion        String?    @db.NVarChar(255)
  icono              String?    @db.NVarChar(50)
  activo             Boolean?   @default(true, map: "DF__Categoria__activ__37A5467C")
  fecha_creacion     DateTime?  @default(dbgenerated("GETDATE()"), map: "DF__Categoria__fecha__38996AB5")
  area               String?    @default("Cocina", map: "DF__Categorias__area__5EBF139D") @db.VarChar(20)
  eliminadoEn        DateTime?  @db.DateTime2
  eliminadoPorId     String?    @db.NVarChar(100)
  eliminadoPorNombre String?    @db.NVarChar(150)
  motivoEliminacion  String?    @db.NVarChar(300)
  productos          Producto[]

  @@map("Categorias")
}

model Producto {
  id                 Int                       @id(map: "PK__Producto__3213E83F276ADAA2") @default(autoincrement())
  nombre             String                    @db.NVarChar(150)
  descripcion        String?                   @db.NVarChar(Max)
  precio             Decimal                   @db.Decimal(10, 2)
  imagen_url         String?                   @db.NVarChar(Max)
  stock              Int?                      @default(0, map: "DF__Productos__stock__3B75D760")
  tipoInventario     String                    @default("DIRECTO") @db.NVarChar(20)
  categoriaId        Int
  activo             Boolean?                  @default(true, map: "DF__Productos__activ__3C69FB99")
  fecha_creacion     DateTime?                 @default(dbgenerated("GETDATE()"), map: "DF__Productos__fecha__3D5E1FD2")
  detallesPedido     PedidoDetalle[]
  movimientosStock   MovimientoStock[]
  devolucionDetalles DevolucionDetalle[]
  eliminadoEn        DateTime?                 @db.DateTime2
  eliminadoPorId     String?                   @db.NVarChar(100)
  eliminadoPorNombre String?                   @db.NVarChar(150)
  motivoEliminacion  String?                   @db.NVarChar(300)
  historialPrecios   ProductoPrecioHistorial[]
  receta             Receta?
  categoria          Categoria                 @relation(fields: [categoriaId], references: [id], onUpdate: NoAction, map: "FK_Productos_Categorias")

  @@map("Productos")
}

model Mesa {
  id                 Int             @id(map: "PK__Mesas__3213E83F474B4572") @default(autoincrement())
  numero             String          @db.NVarChar(20)
  capacidad          Int?            @default(2, map: "DF__Mesas__capacidad__412EB0B6")
  zona               String?         @db.NVarChar(50)
  estado             String?         @default("Libre", map: "DF__Mesas__estado__4222D4EF") @db.NVarChar(20)
  activo             Boolean?        @default(true, map: "DF__Mesas__activo__4316F928")
  fecha_creacion     DateTime?       @default(dbgenerated("GETDATE()"), map: "DF__Mesas__fecha_cre__440B1D61")
  eliminadoEn        DateTime?       @db.DateTime2
  eliminadoPorId     String?         @db.NVarChar(100)
  eliminadoPorNombre String?         @db.NVarChar(150)
  motivoEliminacion  String?         @db.NVarChar(300)
  pedidos            Pedido[]
  reservas           Reserva[]       @relation("MesaAReservas")
  llamados           LlamadoMesero[]

  @@map("Mesas")
}

model Pedido {
  id                    Int             @id(map: "PK__Pedidos__3213E83F1137F0B1") @default(autoincrement())
  mesaId                Int
  usuarioId             String?         @db.UniqueIdentifier
  total                 Decimal         @default(0.00, map: "DF__Pedidos__total__46E78A0C") @db.Decimal(10, 2)
  estado                String          @default("BORRADOR", map: "DF__Pedidos__estado__47DBAE45") @db.NVarChar(30)
  motivoAnulacion       String?         @db.NVarChar(500)
  anuladoEn             DateTime?       @db.DateTime2
  anuladoPorId          String?         @db.NVarChar(100)
  anuladoPorNombre      String?         @db.NVarChar(150)
  cerradoEn             DateTime?       @db.DateTime2
  fecha_creacion        DateTime?       @default(dbgenerated("GETDATE()"), map: "DF__Pedidos__fecha_c__48CFD27E")
  pagadoEn              DateTime?       @db.DateTime2
  subtotal              Decimal         @default(0) @db.Decimal(10, 2)
  descuentoTotal        Decimal         @default(0) @db.Decimal(10, 2)
  propinaTotal          Decimal         @default(0) @db.Decimal(10, 2)
  totalPagado           Decimal         @default(0) @db.Decimal(10, 2)
  saldo                 Decimal         @default(0) @db.Decimal(10, 2)
  estadoPago            String          @default("Pendiente") @db.NVarChar(20)
  origen                String          @default("POS") @db.NVarChar(20)
  inventarioConsumido   Boolean         @default(false)
  inventarioConsumidoEn DateTime?       @db.DateTime2
  nombreMesero          String?         @db.NVarChar(100)
  metodoPago            String?         @db.NVarChar(30)
  detalles              PedidoDetalle[]
  pagos                 Pago[]
  descuento             Descuento?
  devoluciones          Devolucion[]
  comprobante           Comprobante?
  mesa                  Mesa            @relation(fields: [mesaId], references: [id], onUpdate: NoAction, map: "FK_Pedidos_Mesas")

  @@map("Pedidos")
}

model PedidoDetalle {
  id                 Int                 @id(map: "PK__Pedido_D__3213E83F64EC93C8") @default(autoincrement())
  pedidoId           Int
  productoId         Int
  cantidad           Int
  precio_unitario    Decimal             @db.Decimal(10, 2)
  // subtotal es una columna calculada en SQL Server; no se gestiona desde Prisma.
  estado             String              @default("PENDIENTE") @db.NVarChar(20)
  costoUnitario      Decimal?            @db.Decimal(14, 4)
  costoTotal         Decimal?            @db.Decimal(14, 4)
  pedido             Pedido              @relation(fields: [pedidoId], references: [id], onUpdate: NoAction, map: "FK_Detalle_Pedido")
  producto           Producto            @relation(fields: [productoId], references: [id], onUpdate: NoAction, map: "FK_Detalle_Producto")
  aplicaciones       PagoAplicacion[]
  devolucionDetalles DevolucionDetalle[]

  @@map("Pedido_Detalles")
}

model Reserva {
  id              Int      @id @default(autoincrement())
  clienteNombre   String   @db.NVarChar(100)
  clienteTelefono String   @db.NVarChar(20)
  fechaReserva    DateTime @db.DateTime
  franjaInicio    DateTime @db.DateTime2
  numPersonas     Int
  mesaId          Int
  estado          String   @default("Confirmada") @db.NVarChar(20)
  fecha_creacion  DateTime @default(dbgenerated("GETDATE()")) @db.DateTime
  mesa            Mesa     @relation("MesaAReservas", fields: [mesaId], references: [id])

  @@map("Reservas")
}

model TurnoCaja {
  id                Int              @id @default(autoincrement())
  cajeroId          String           @db.UniqueIdentifier
  cajeroNombre      String           @db.NVarChar(150)
  estado            String           @default("Abierto") @db.NVarChar(20)
  abiertoEn         DateTime         @default(now()) @db.DateTime2
  cerradoEn         DateTime?        @db.DateTime2
  fondoInicial      Decimal          @default(0) @db.Decimal(10, 2)
  totalEfectivo     Decimal          @default(0) @db.Decimal(10, 2)
  totalTarjeta      Decimal          @default(0) @db.Decimal(10, 2)
  totalBilleteras   Decimal          @default(0) @db.Decimal(10, 2)
  totalOtros        Decimal          @default(0) @db.Decimal(10, 2)
  totalVentas       Decimal          @default(0) @db.Decimal(10, 2)
  totalPropinas     Decimal          @default(0) @db.Decimal(10, 2)
  totalDescuentos   Decimal          @default(0) @db.Decimal(10, 2)
  totalDevoluciones Decimal          @default(0) @db.Decimal(10, 2)
  totalCobrado      Decimal          @default(0) @db.Decimal(10, 2)
  totalIngresos     Decimal          @default(0) @db.Decimal(10, 2)
  totalRetiros      Decimal          @default(0) @db.Decimal(10, 2)
  totalGastos       Decimal          @default(0) @db.Decimal(10, 2)
  efectivoEsperado  Decimal?         @db.Decimal(10, 2)
  efectivoContado   Decimal?         @db.Decimal(10, 2)
  diferencia        Decimal?         @db.Decimal(10, 2)
  justificacion     String?          @db.NVarChar(500)
  cerradoPorId      String?          @db.UniqueIdentifier
  cerradoPorNombre  String?          @db.NVarChar(150)
  createdAt         DateTime         @default(now()) @db.DateTime2
  updatedAt         DateTime         @updatedAt @db.DateTime2
  pagos             Pago[]
  movimientos       MovimientoCaja[]
  eventos           CajaEvento[]
  devoluciones      Devolucion[]

  @@index([estado, abiertoEn])
  @@map("TurnosCaja")
}

model Pago {
  id                  Int              @id @default(autoincrement())
  pedidoId            Int
  turnoId             Int?
  cajeroId            String?          @db.UniqueIdentifier
  cajeroNombre        String?          @db.NVarChar(150)
  metodo              String           @db.NVarChar(30)
  monto               Decimal          @db.Decimal(10, 2)
  propina             Decimal          @default(0) @db.Decimal(10, 2)
  descuento           Decimal          @default(0) @db.Decimal(10, 2)
  referencia          String?          @db.NVarChar(100)
  codigoAutorizacion  String?          @db.NVarChar(100)
  terminal            String?          @db.NVarChar(50)
  montoRecibido       Decimal?         @db.Decimal(10, 2)
  cambio              Decimal?         @db.Decimal(10, 2)
  etiqueta            String?          @db.NVarChar(50)
  autorizadoPorId     String?          @db.UniqueIdentifier
  autorizadoPorNombre String?          @db.NVarChar(150)
  anuladoPorId        String?          @db.UniqueIdentifier
  anuladoPorNombre    String?          @db.NVarChar(150)
  anuladoEn           DateTime?        @db.DateTime2
  motivoAnulacion     String?          @db.NVarChar(500)
  estado              String           @default("Registrado") @db.NVarChar(20)
  origen              String           @default("POS") @db.NVarChar(20)
  conciliadoEn        DateTime?        @db.DateTime2
  conciliadoPorId     String?          @db.UniqueIdentifier
  createdAt           DateTime         @default(now()) @db.DateTime2
  pedido              Pedido           @relation(fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Pagos_Pedidos")
  turno               TurnoCaja?       @relation(fields: [turnoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Pagos_TurnosCaja")
  aplicaciones        PagoAplicacion[]
  devoluciones        Devolucion[]

  @@index([turnoId, estado])
  @@index([pedidoId])
  @@index([createdAt])
  @@map("Pagos")
}

model MovimientoCaja {
  id            Int       @id @default(autoincrement())
  turnoId       Int
  tipo          String    @db.NVarChar(20)
  monto         Decimal   @db.Decimal(10, 2)
  motivo        String    @db.NVarChar(300)
  usuarioId     String    @db.UniqueIdentifier
  usuarioNombre String    @db.NVarChar(150)
  createdAt     DateTime  @default(now()) @db.DateTime2
  turno         TurnoCaja @relation(fields: [turnoId], references: [id], onUpdate: NoAction, map: "FK_MovimientosCaja_TurnosCaja")

  @@index([turnoId, createdAt])
  @@map("MovimientosCaja")
}

model CajaEvento {
  id            Int       @id @default(autoincrement())
  turnoId       Int
  tipo          String    @db.NVarChar(30)
  detalle       String?   @db.NVarChar(Max)
  monto         Decimal?  @db.Decimal(10, 2)
  usuarioId     String?   @db.UniqueIdentifier
  usuarioNombre String?   @db.NVarChar(150)
  createdAt     DateTime  @default(now()) @db.DateTime2
  turno         TurnoCaja @relation(fields: [turnoId], references: [id], onUpdate: NoAction, map: "FK_CajaEventos_TurnosCaja")

  @@index([turnoId, createdAt])
  @@map("CajaEventos")
}

model PagoAplicacion {
  id              Int           @id @default(autoincrement())
  pagoId          Int
  pedidoDetalleId Int
  cantidad        Int
  monto           Decimal       @db.Decimal(10, 2)
  pago            Pago          @relation(fields: [pagoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PagoAplicaciones_Pagos")
  pedidoDetalle   PedidoDetalle @relation(fields: [pedidoDetalleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PagoAplicaciones_Detalles")

  @@unique([pagoId, pedidoDetalleId])
  @@index([pedidoDetalleId])
  @@map("PagoAplicaciones")
}

model Descuento {
  id                  Int      @id @default(autoincrement())
  pedidoId            Int      @unique
  tipo                String   @db.NVarChar(20)
  valor               Decimal  @db.Decimal(10, 2)
  montoAplicado       Decimal  @db.Decimal(10, 2)
  motivo              String   @db.NVarChar(300)
  cuponId             Int?
  autorizadoPorId     String?  @db.UniqueIdentifier
  autorizadoPorNombre String?  @db.NVarChar(150)
  createdAt           DateTime @default(now()) @db.DateTime2
  pedido              Pedido   @relation(fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Descuentos_Pedidos")
  cupon               Cupon?   @relation(fields: [cuponId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Descuentos_Cupones")

  @@index([cuponId])
  @@map("Descuentos")
}

model Cupon {
  id                 Int         @id @default(autoincrement())
  codigo             String      @unique @db.NVarChar(50)
  tipo               String      @db.NVarChar(20)
  valor              Decimal     @db.Decimal(10, 2)
  validoDesde        DateTime?   @db.DateTime2
  validoHasta        DateTime?   @db.DateTime2
  usosMaximos        Int?
  usos               Int         @default(0)
  activo             Boolean     @default(true)
  eliminadoEn        DateTime?   @db.DateTime2
  eliminadoPorId     String?     @db.NVarChar(100)
  eliminadoPorNombre String?     @db.NVarChar(150)
  motivoEliminacion  String?     @db.NVarChar(300)
  createdAt          DateTime    @default(now()) @db.DateTime2
  descuentos         Descuento[]

  @@map("Cupones")
}

model Devolucion {
  id                  Int                 @id @default(autoincrement())
  pedidoId            Int
  pagoId              Int?
  turnoId             Int
  cajeroId            String              @db.UniqueIdentifier
  cajeroNombre        String              @db.NVarChar(150)
  metodo              String              @db.NVarChar(30)
  monto               Decimal             @db.Decimal(10, 2)
  propina             Decimal             @default(0) @db.Decimal(10, 2)
  motivo              String              @db.NVarChar(500)
  autorizadoPorId     String?             @db.UniqueIdentifier
  autorizadoPorNombre String?             @db.NVarChar(150)
  estado              String              @default("Registrada") @db.NVarChar(20)
  reversionStock      Boolean             @default(false)
  conciliadoEn        DateTime?           @db.DateTime2
  conciliadoPorId     String?             @db.UniqueIdentifier
  createdAt           DateTime            @default(now()) @db.DateTime2
  pedido              Pedido              @relation(fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Devoluciones_Pedidos")
  pago                Pago?               @relation(fields: [pagoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Devoluciones_Pagos")
  turno               TurnoCaja           @relation(fields: [turnoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Devoluciones_TurnosCaja")
  detalles            DevolucionDetalle[]

  @@index([pedidoId])
  @@index([pagoId])
  @@index([turnoId, estado])
  @@map("Devoluciones")
}

model DevolucionDetalle {
  id              Int            @id @default(autoincrement())
  devolucionId    Int
  pedidoDetalleId Int?
  productoId      Int
  cantidad        Int
  monto           Decimal?       @db.Decimal(10, 2)
  devolucion      Devolucion     @relation(fields: [devolucionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DevolucionDetalles_Devoluciones")
  pedidoDetalle   PedidoDetalle? @relation(fields: [pedidoDetalleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DevolucionDetalles_Detalles")
  producto        Producto       @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_DevolucionDetalles_Productos")

  @@index([devolucionId])
  @@index([productoId])
  @@map("DevolucionDetalles")
}

model MovimientoStock {
  id            Int      @id @default(autoincrement())
  productoId    Int
  cantidad      Int
  tipo          String   @db.NVarChar(20)
  motivo        String?  @db.NVarChar(300)
  referenciaId  Int?
  usuarioId     String?  @db.UniqueIdentifier
  usuarioNombre String?  @db.NVarChar(150)
  createdAt     DateTime @default(now()) @db.DateTime2
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_MovimientosStock_Productos")

  @@index([productoId, createdAt])
  @@map("MovimientosStock")
}

model Comprobante {
  id        Int      @id @default(autoincrement())
  pedidoId  Int      @unique
  tipo      String   @default("Ticket") @db.NVarChar(20)
  monto     Decimal  @db.Decimal(10, 2)
  estado    String   @default("Emitido") @db.NVarChar(20)
  createdAt DateTime @default(now()) @db.DateTime2
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Comprobantes_Pedidos")

  @@map("Comprobantes")
}

model IdempotencyKey {
  id          String   @id @db.NVarChar(64)
  key         String   @unique @db.NVarChar(100)
  scope       String   @default("legacy") @db.NVarChar(150)
  requestHash String?  @db.NVarChar(64)
  status      Int      @default(0)
  response    String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now()) @db.DateTime2
  expiresAt   DateTime @db.DateTime2

  @@index([expiresAt])
  @@map("Idempotency_Keys")
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  actorId     String?  @db.NVarChar(100)
  actorNombre String?  @db.NVarChar(150)
  actorRol    String?  @db.NVarChar(100)
  ip          String?  @db.NVarChar(64)
  userAgent   String?  @db.NVarChar(500)
  accion      String   @db.NVarChar(100)
  entidad     String?  @db.NVarChar(50)
  entidadId   String?  @db.NVarChar(100)
  antes       String?  @db.NVarChar(Max)
  despues     String?  @db.NVarChar(Max)
  motivo      String?  @db.NVarChar(500)
  requestId   String?  @db.NVarChar(100)
  turnoId     Int?
  createdAt   DateTime @default(now()) @db.DateTime2

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([accion, createdAt])
  @@index([entidad, entidadId])
  @@index([turnoId])
  @@map("Auditoria")
}

model UsuarioApp {
  id             Int              @id @default(autoincrement())
  sasiSub        String           @unique @db.NVarChar(100)
  nombre         String           @db.NVarChar(150)
  email          String?          @db.NVarChar(200)
  rolSasi        String?          @db.NVarChar(100)
  activo         Boolean          @default(true)
  ultimoAccesoEn DateTime?        @db.DateTime2
  createdAt      DateTime         @default(now()) @db.DateTime2
  updatedAt      DateTime         @updatedAt @db.DateTime2
  roles          UsuarioRol[]
  permisos       UsuarioPermiso[]

  @@index([activo])
  @@map("UsuariosApp")
}

model RolLocal {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique @db.NVarChar(50)
  nombre      String       @db.NVarChar(100)
  descripcion String?      @db.NVarChar(300)
  esSistema   Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.DateTime2
  updatedAt   DateTime     @updatedAt @db.DateTime2
  permisos    RolPermiso[]
  usuarios    UsuarioRol[]

  @@map("RolesLocal")
}

model Permiso {
  id          Int              @id @default(autoincrement())
  codigo      String           @unique @db.NVarChar(100)
  nombre      String           @db.NVarChar(150)
  descripcion String?          @db.NVarChar(300)
  grupo       String           @db.NVarChar(50)
  createdAt   DateTime         @default(now()) @db.DateTime2
  updatedAt   DateTime         @updatedAt @db.DateTime2
  roles       RolPermiso[]
  usuarios    UsuarioPermiso[]

  @@index([grupo])
  @@map("Permisos")
}

model RolPermiso {
  rolId     Int
  permisoId Int
  rol       RolLocal @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
  @@map("RolPermisos")
}

model UsuarioRol {
  usuarioId Int
  rolId     Int
  usuario   UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       RolLocal   @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@index([rolId])
  @@map("UsuarioRoles")
}

model UsuarioPermiso {
  usuarioId Int
  permisoId Int
  permitido Boolean    @default(true)
  usuario   UsuarioApp @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso   Permiso    @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@index([permisoId])
  @@map("UsuarioPermisos")
}

model ProductoPrecioHistorial {
  id             Int      @id @default(autoincrement())
  productoId     Int
  precioAnterior Decimal? @db.Decimal(10, 2)
  precioNuevo    Decimal  @db.Decimal(10, 2)
  motivo         String?  @db.NVarChar(300)
  usuarioId      String?  @db.NVarChar(100)
  usuarioNombre  String?  @db.NVarChar(150)
  createdAt      DateTime @default(now()) @db.DateTime2
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productoId, createdAt])
  @@map("ProductoPrecioHistorial")
}

model LlamadoMesero {
  id                Int       @id @default(autoincrement())
  mesaId            Int
  usuarioId         String?   @db.UniqueIdentifier
  nombreMesero      String?   @db.NVarChar(100)
  estado            String    @default("PENDIENTE") @db.NVarChar(20)
  creadoEn          DateTime  @default(now()) @db.DateTime2
  atendidoEn        DateTime? @db.DateTime2
  atendidoPorId     String?   @db.UniqueIdentifier
  atendidoPorNombre String?   @db.NVarChar(150)
  mesa              Mesa      @relation(fields: [mesaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mesaId, estado, creadoEn])
  @@map("LlamadosMesero")
}

model UnidadMedida {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique @db.NVarChar(20)
  nombre     String   @db.NVarChar(100)
  tipo       String   @db.NVarChar(20)
  factorBase Decimal  @default(1) @db.Decimal(18, 6)
  activo     Boolean  @default(true)
  insumos    Insumo[]

  @@map("UnidadesMedida")
}

model Almacen {
  id                 Int                @id @default(autoincrement())
  codigo             String             @unique @db.NVarChar(30)
  nombre             String             @db.NVarChar(100)
  tipo               String             @db.NVarChar(20)
  activo             Boolean            @default(true)
  stocks             InsumoStock[]
  movimientosOrigen  InsumoMovimiento[] @relation("MovimientoAlmacenOrigen")
  movimientosDestino InsumoMovimiento[] @relation("MovimientoAlmacenDestino")

  @@map("Almacenes")
}

model Insumo {
  id                 Int                @id @default(autoincrement())
  nombre             String             @db.NVarChar(150)
  unidadBaseId       Int
  stockMinimo        Decimal            @default(0) @db.Decimal(14, 3)
  puntoRecompra      Decimal            @default(0) @db.Decimal(14, 3)
  leadTimeDias       Int                @default(0)
  costoPromedio      Decimal            @default(0) @db.Decimal(14, 4)
  activo             Boolean            @default(true)
  eliminadoEn        DateTime?          @db.DateTime2
  eliminadoPorId     String?            @db.NVarChar(100)
  eliminadoPorNombre String?            @db.NVarChar(150)
  motivoEliminacion  String?            @db.NVarChar(300)
  createdAt          DateTime           @default(now()) @db.DateTime2
  updatedAt          DateTime           @updatedAt @db.DateTime2
  unidadBase         UnidadMedida       @relation(fields: [unidadBaseId], references: [id], onUpdate: NoAction)
  stocks             InsumoStock[]
  movimientos        InsumoMovimiento[]
  recetaDetalles     RecetaDetalle[]

  @@index([activo])
  @@map("Insumos")
}

model InsumoStock {
  insumoId  Int
  almacenId Int
  cantidad  Decimal @default(0) @db.Decimal(14, 3)
  insumo    Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([insumoId, almacenId])
  @@index([almacenId])
  @@map("InsumoStock")
}

model Receta {
  id              Int             @id @default(autoincrement())
  productoId      Int             @unique
  rendimiento     Decimal         @default(1) @db.Decimal(10, 3)
  mermaPorcentaje Decimal         @default(0) @db.Decimal(5, 2)
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.DateTime2
  updatedAt       DateTime        @updatedAt @db.DateTime2
  producto        Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  detalles        RecetaDetalle[]

  @@map("Recetas")
}

model RecetaDetalle {
  id       Int     @id @default(autoincrement())
  recetaId Int
  insumoId Int
  cantidad Decimal @db.Decimal(14, 3)
  receta   Receta  @relation(fields: [recetaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  insumo   Insumo  @relation(fields: [insumoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recetaId, insumoId])
  @@index([insumoId])
  @@map("RecetaDetalles")
}

model InsumoMovimiento {
  id                Int      @id @default(autoincrement())
  insumoId          Int
  almacenId         Int
  almacenDestinoId  Int?
  tipo              String   @db.NVarChar(30)
  cantidad          Decimal  @db.Decimal(14, 3)
  costoUnitario     Decimal  @default(0) @db.Decimal(14, 4)
  costoTotal        Decimal  @default(0) @db.Decimal(14, 4)
  motivo            String?  @db.NVarChar(300)
  responsableId     String?  @db.NVarChar(100)
  responsableNombre String?  @db.NVarChar(150)
  referenciaTipo    String?  @db.NVarChar(30)
  referenciaId      Int?
  pedidoId          Int?
  pedidoDetalleId   Int?
  createdAt         DateTime @default(now()) @db.DateTime2
  insumo            Insumo   @relation(fields: [insumoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  almacen           Almacen  @relation("MovimientoAlmacenOrigen", fields: [almacenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  almacenDestino    Almacen? @relation("MovimientoAlmacenDestino", fields: [almacenDestinoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([insumoId, createdAt])
  @@index([almacenId, createdAt])
  @@index([pedidoId])
  @@map("InsumoMovimientos")
}
