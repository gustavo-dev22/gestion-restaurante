# Base de datos SQL Server
DATABASE_URL="sqlserver://localhost:1433;database=db_restaurante;user=restauranteuser;password=CAMBIAR;trustServerCertificate=true"

# API SASI (servidor interno)
NEXT_PUBLIC_SASI_API=https://localhost:44337/SASI/api

# SSO SASI (authorization code + PKCE)
# Cliente registrado en SASI (Sso:Clientes). Debe existir en la tabla SistemaCliente.
SASI_SSO_CLIENT_ID="restaurante"
# Opcionales: si no se definen se derivan de NEXT_PUBLIC_SASI_API.
# SASI_SSO_LOGIN_URL="https://localhost:44337/SASI/Cuenta/Login"
# SASI_SSO_TOKEN_URL="https://localhost:44337/SASI/api/auth/token"
# SASI_SSO_LOGOUT_URL="https://localhost:44337/SASI/Cuenta/Logout"
# SASI_SSO_PING_URL="https://localhost:44337/SASI/api/auth/ping"
# URI exacta registrada en SASI. Si no se define, se usa el origen de la petición + /sso-callback.
# SASI_SSO_REDIRECT_URI="http://localhost:4206/sso-callback"
# Evita el ping previo a SASI (solo para pruebas sin SASI levantado).
# SASI_SSO_SKIP_PING="true"

# Clave para firmar la cookie de sesión (obligatoria, mínimo 32 caracteres en producción)
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-de-64-caracteres"

# Solo desarrollo local: permite el certificado auto-firmado de SASI en la petición de login.
# NUNCA debe activarse en producción.
SASI_INSECURE_TLS="false"

# Cookie de sesión: true con HTTPS (recomendado), false solo para LAN HTTP.
# Si no se define, en producción es true y en desarrollo false.
SESSION_COOKIE_SECURE="true"

# Dominios autorizados para next/image (separados por coma). Sin comodines.
IMAGE_ALLOWED_HOSTS="tu-cdn.com,images.unsplash.com"
